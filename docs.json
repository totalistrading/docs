          {
            "tab": "API reference",
            "openapi": "/hyperliquid/openapi.json",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "hyperliquid/api-reference/introduction"
                ]
              },
              {
                "group": "Markets",
                "pages": [
                  "GET /v1/markets",
                  "GET /v1/markets/{outcome_id}",
                  "GET /v1/markets/{outcome_id}/history"
                ]
              },
              {
                "group": "RFQs & Quotes",
                "pages": [
                  {
                    "group": "Taking",
                    "pages": [
                      "POST /v1/rfqs",
                      "POST /v1/quotes/{quote_id}/accept",
                      "POST /v1/rfqs/{rfq_id}/cancel",
                      "POST /v1/me/positions/{position_id}/cashout"
                    ]
                  },
                  {
                    "group": "Making",
                    "pages": [
                      "POST /v1/rfqs/{rfq_id}/quotes",
                      "DELETE /v1/quotes/{quote_id}",
                      "POST /v1/quotes/{quote_id}/confirm",
                      "GET /v1/makers/{maker_id}/acceptances"
                    ]
                  },
                  {
                    "group": "Reads",
                    "pages": [
                      "GET /v1/rfqs",
                      "GET /v1/rfqs/{rfq_id}",
                      "GET /v1/rfqs/{rfq_id}/quotes",
                      "GET /v1/quotes/{quote_id}/acceptance"
                    ]
                  }
                ]
              },
              {
                "group": "Positions",
                "pages": [
                  "GET /v1/me/positions",
                  "GET /v1/me/positions/{position_id}"
                ]
              },
              {
                "group": "Account",
                "pages": [
                  "GET /v1/me",
                  "GET /v1/me/balances",
                  "GET /v1/me/activity",
                  "GET /v1/me/pnl",
                  "GET /v1/me/operations",
                  "GET /v1/me/operations/{operation_id}",
                  "POST /v1/me/withdrawals",
                  "GET /v1/me/withdrawals/{withdrawal_id}",
                  "POST /v1/me/deposits",
                  "POST /v1/core-exits",
                  "GET /v1/me/core-exits",
                  "GET /v1/core-exits/{exit_id}",
                  "POST /v1/core-exits/{exit_id}/abandon"
                ]
              },
              {
                "group": "Makers",
                "pages": [
                  "GET /v1/makers/{maker_id}/capital",
                  "POST /v1/makers/{maker_id}/collateral-reductions",
                  "GET /v1/makers/{maker_id}/collateral-reductions/{job_id}",
                  "GET /v1/makers/{maker_id}/withdrawal",
                  "POST /v1/makers/{maker_id}/operations/{operation_id}/self-funded-transaction"
                ]
              },
              {
                "group": "Partners & wallet sign-in",
                "pages": [
                  "POST /v1/partner/wallet-admissions",
                  "POST /v1/auth/wallet-challenges",
                  "POST /v1/auth/wallet-sessions",
                  "DELETE /v1/auth/wallet-sessions/current"
                ]
              },
              {
                "group": "Deployment",
                "pages": [
                  "GET /v1/deployment"
                ]
              },
              {
                "group": "WebSocket",
                "pages": [
                  "hyperliquid/api-reference/websocket/connection",
                  "hyperliquid/api-reference/websocket/account",
                  "hyperliquid/api-reference/websocket/maker",
                  "hyperliquid/api-reference/websocket/market-data",
                  "GET /v1/stream"
                ]
              }
            ]
